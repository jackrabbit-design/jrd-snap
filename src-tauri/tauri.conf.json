{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snap",
  "version": "0.5.0",
  "identifier": "com.snap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Snap",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Snap Settings",
        "url": "index.html#/settings",
        "width": 520,
        "height": 768,
        "visible": false,
        "hiddenTitle": true,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "editor",
        "title": "Snap Editor",
        "url": "index.html#/editor",
        "width": 900,
        "height": 700,
        "minWidth": 900,
        "visible": false,
        "hiddenTitle": true,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "recording-controls",
        "title": "Snap Recording Controls",
        "url": "index.html#/recording-controls",
        "width": 180,
        "height": 56,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "history",
        "title": "Snap Recent Captures",
        "url": "index.html#/history",
        "width": 640,
        "height": 460,
        "visible": false,
        "hiddenTitle": true,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "drop-upload",
        "title": "Snap Quick Upload",
        "url": "index.html#/drop-upload",
        "width": 160,
        "height": 160,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/std-32.png",
      "icons/std-32@2x.png",
      "icons/std-128.png",
      "icons/std-128@2x.png"
    ],
    "resources": [
      "icons/std-*.png",
      "icons/progress-*.png",
      "icons/success-*.png",
      "binaries/FFMPEG_LICENSE.txt"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "macOS": {
      "signingIdentity": "Snap Local Code Signing"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1ODBCNTM5MThCM0Y2OTYKUldTVzlyTVlPYldBNVlaazJVWmlDMkp5VjZUaE9BRmRla3Fwa1V6QzhZSjg0c0FRcTZtRng4amgK",
      "endpoints": [
        "https://github.com/jackrabbit-design/jrd-snap/releases/latest/download/latest.json"
      ]
    }
  }
}
